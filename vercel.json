{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/pdfs/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=3600"},
        {"key": "Content-Disposition", "value": "inline"}
      ]
    }
  ]
}
